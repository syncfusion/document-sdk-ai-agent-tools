{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Redis": {
    // No ConnectionString here intentionally — app uses in-memory cache in Development.
    // Set Redis:ConnectionString (or REDIS_CONNECTION_STRING env var) in Production.
    "SessionTtlMinutes": 60
  },
  "AzureBlobStorage": {
    "ConnectionString": "Your_Connetion_String",
    "ContainerName": "Your_Container_Name"
  }
}
